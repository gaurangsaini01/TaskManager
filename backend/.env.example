# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Pooled connection string (the one with "-pooler" in the host) — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection string — used by `prisma migrate`
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Separate database or Neon branch used by the test suite.
# WARNING: tests TRUNCATE ALL TABLES here — never point this at real data.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-yyy-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# ── Cloudinary (task attachments) — values from your Cloudinary dashboard ─────
# Also enable "Allow delivery of PDF and ZIP files" under Settings → Security,
# otherwise PDF attachment URLs return 401 on free accounts.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Seed (`npm run db:seed` creates this admin account) ───────────────────────
ADMIN_EMAIL="admin@taskmanager.local"
ADMIN_PASSWORD="Admin123!"
